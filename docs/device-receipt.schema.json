{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OMORI (PMJS) device verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "sha256",
    "device",
    "cfw",
    "resolution",
    "tests",
    "verifiedUtc"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "cfw": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verifiedUtc": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
